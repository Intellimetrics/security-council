      },
      "title": "OS command injection through the report format parameter",
      "summary": "`build_report()` interpolates the request-derived `fmt` into an `os.system()` shell string; `/bin/sh -c` interprets metacharacters, so any caller of `/api/reports` executes commands as the service user.",
      "severity": {
        "level": "critical",
        "score": 9.8,
        "scoringSystem": "CVSS:3.1"
      },
      "confidence": {
        "level": "high",
        "rationale": "Direct source trace from `request.args['format']` in `app/routes.py` to `os.system` with no validation."
      },
      "taxonomy": {
        "category": "command-injection",
        "cwe": [
          "CWE-78"
        ]
      },
      "locations": [
        {
          "path": "app/routes.py",
          "startLine": 5,
          "endLine": 5,
          "role": "user_input"
        },
        {
          "path": "app/reports.py",
          "startLine": 11,
          "endLine": 11,
          "role": "sink"
        }
      ],
      "codeEvidence": [
        {
          "id": "sink",
          "label": "Shell string built from fmt",
          "path": "app/reports.py",
          "startLine": 11,
          "endLine": 11,
          "language": "python",
          "role": "sink",
          "code": "os.system(f\"/usr/bin/render --format {fmt} --rows {len(rows)}\")",
          "explanation": "`fmt` reaches the shell unchanged."
        }
      ],
      "rootCause": {
        "summary": "The renderer is invoked through a shell with attacker-controlled text instead of an argument vector.",
        "evidenceRefs": [
          "sink"
        ]
      },
      "remediation": "Allow-list `fmt` and invoke the renderer with `subprocess.run([...], shell=False)`.",
      "validation": {
        "method": "Offline static source review with focused forward/backward dataflow confirmation.",
        "status": "validated",
        "result": "confirmed",
        "evidenceRefs": [
          "cmd-source",
          "cmd-sink"
        ]
      },
      "attackPath": {
        "decision": "reportable",
        "reachability": "unauthenticated HTTP",
        "impact": "high",
        "likelihood": "high",
        "severity": "critical"
      },
      "remediationTests": [
        "Assert that `format=pdf;id` is rejected with 400 and nothing executes."
      ],
      "preventiveControls": [
        "Ban `os.system`/`shell=True` via a lint rule."
      ],
      "provenance": {
        "source": "local_plugin"
      },
      "extensions": {}
    },

        {
          "ruleId": "CWE-639",
          "ruleIndex": 1,
          "level": "error",
          "message": {
            "text": "Order lookup has no tenant/owner check (IDOR).\n\nget_order() selects by primary key only; routes.py passes the URL id straight through and there is no authentication on the route.\n\nImpact: Any caller can read every tenant's order records by enumerating ids.\n\nExploit scenario: GET /api/orders/1, /2, /3 ... returns other tenants' orders including tenant_id and total.\n\nRecommendation: Derive the tenant from the session and add AND tenant_id = ? to the query.\n\nCWE-639. Severity HIGH, confidence high."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app/order_repo.py",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 12,
                  "snippet": {
                    "text": "cur.execute(\"SELECT id, tenant_id, total FROM orders WHERE id = ?\", (order_id,))"
                  }
                }
              },
              "logicalLocations": [
                {
                  "name": "get_order",
                  "fullyQualifiedName": "get_order"
                }
              ]
            }
          ],
          "partialFingerprints": {

        {
          "ruleId": "CWE-78",
          "ruleIndex": 3,
          "level": "error",
          "message": {
            "text": "OS command injection via report format parameter.\n\nbuild_report() interpolates the request-derived fmt into an os.system() shell string.\n\nImpact: Remote command execution as the web server user.\n\nExploit scenario: GET /api/reports?format=pdf;id>/tmp/pwned runs id on the server.\n\nRecommendation: Allow-list fmt and call subprocess.run([...], shell=False).\n\nCWE-78. Severity HIGH, confidence medium."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app/reports.py",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 11,
                  "snippet": {
                    "text": "os.system(f\"/usr/bin/render --format {fmt} --rows {len(rows)}\")"
                  }
                }
              },
              "logicalLocations": [

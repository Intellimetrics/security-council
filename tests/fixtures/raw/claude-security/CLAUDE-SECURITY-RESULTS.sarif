        {
          "ruleId": "CWE-916",
          "ruleIndex": 0,
          "level": "error",
          "message": {
            "text": "Passwords hashed with unsalted MD5.\n\nhash_password() computes hashlib.md5(pw).hexdigest() with no salt and no work factor.\n\nImpact: Any leak of the stored hashes yields plaintext passwords for most users.\n\nExploit scenario: An attacker who obtains the hash store runs a GPU dictionary attack and recovers passwords in minutes.\n\nPreconditions: Read access to the stored hashes.\n\nRecommendation: Use argon2id/bcrypt/scrypt with a per-user salt.\n\nCWE-916. Severity HIGH, confidence high."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app/crypto_util.py",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 7,
                  "snippet": {
                    "text": "return hashlib.md5(pw.encode()).hexdigest()"
                  }
                }
              },
              "logicalLocations": [
                {
                  "name": "hash_password",
                  "fullyQualifiedName": "hash_password"
                }
              ]
            }
          ],
          "partialFingerprints": {
            "claude-security-plugin/v2": "14a0e93eae03810866443957dd599b59e7041d86a4ceea0342a45be4b41245f7"
          },

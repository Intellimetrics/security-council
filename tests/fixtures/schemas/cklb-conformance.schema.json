{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "security-council/cklb-conformance",
  "title": "CKLB (STIG Viewer 3 checklist) — hand-authored conformance subset",
  "description": "DISA publishes no machine-readable CKLB schema. This subset is derived from TWO independent authorities, both consulted 2026-08-24: (1) the DoD reference producer, STIG Manager's cklbFromAssetStigs (NUWCDIVNPT/stig-manager, api/source/service/AssetService.js), which fixes the object shape and the snake_case serialization; and (2) the official DISA STIG Viewer 3.x User Guide V1R5 (dl.dod.cyber.mil/wp-content/uploads/stigs/pdf/U_STIG_Viewer_3-x_User_Guide_V1R5.pdf) section 'Checklists', which fixes the four-value status vocabulary (Open, Not a Finding, Not Reviewed, Not Applicable). It constrains what we emit; it does NOT claim to be the complete DISA format, and passing it is not the same as being loaded by STIG Viewer itself.",
  "type": "object",
  "required": ["title", "id", "active", "mode", "has_path", "target_data", "stigs"],
  "properties": {
    "title": {"type": "string", "minLength": 1},
    "id": {"type": "string", "pattern": "^[0-9a-fA-F-]{36}$"},
    "active": {"type": "boolean"},
    "mode": {"type": "integer"},
    "has_path": {"type": "boolean"},
    "target_data": {
      "type": "object",
      "required": ["target_type", "host_name", "ip_address", "mac_address", "fqdn",
                   "comments", "role", "is_web_database", "technology_area",
                   "web_db_site", "web_db_instance"],
      "properties": {
        "target_type": {"type": "string"},
        "host_name": {"type": "string"},
        "ip_address": {"type": "string"},
        "mac_address": {"type": "string"},
        "fqdn": {"type": "string"},
        "comments": {"type": "string"},
        "role": {"type": "string"},
        "is_web_database": {"type": "boolean"},
        "technology_area": {"type": "string"},
        "web_db_site": {"type": "string"},
        "web_db_instance": {"type": "string"}
      }
    },
    "stigs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["stig_name", "display_name", "stig_id", "version", "release_info",
                     "uuid", "reference_identifier", "size", "rules"],
        "properties": {
          "stig_name": {"type": "string", "minLength": 1},
          "display_name": {"type": "string", "minLength": 1},
          "stig_id": {"type": "string", "minLength": 1},
          "version": {"type": "string"},
          "release_info": {"type": "string"},
          "uuid": {"type": "string", "pattern": "^[0-9a-fA-F-]{36}$"},
          "reference_identifier": {"type": "string"},
          "size": {"type": "integer", "minimum": 0},
          "rules": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["uuid", "stig_uuid", "group_id", "rule_id", "rule_id_src",
                           "weight", "classification", "severity", "rule_version",
                           "group_title", "rule_title", "discussion", "check_content",
                           "fix_text", "status", "comments", "finding_details", "ccis",
                           "overrides", "legacy_ids", "group_tree", "check_content_ref"],
              "properties": {
                "uuid": {"type": "string", "pattern": "^[0-9a-fA-F-]{36}$"},
                "stig_uuid": {"type": "string", "pattern": "^[0-9a-fA-F-]{36}$"},
                "target_key": {"type": ["string", "null"]},
                "stig_ref": {"type": ["string", "null"]},
                "group_id": {"type": "string", "pattern": "^V-[0-9]+$"},
                "rule_id": {"type": "string", "pattern": "^SV-[0-9]+r[0-9]+$"},
                "rule_id_src": {"type": "string", "pattern": "^SV-[0-9]+r[0-9]+_rule$"},
                "weight": {"type": "string"},
                "classification": {"type": "string", "minLength": 1},
                "severity": {"enum": ["high", "medium", "low"]},
                "rule_version": {"type": "string", "minLength": 1},
                "group_title": {"type": "string"},
                "rule_title": {"type": "string", "minLength": 1},
                "discussion": {"type": "string"},
                "check_content": {"type": "string"},
                "fix_text": {"type": "string"},
                "status": {"enum": ["open", "not_a_finding", "not_reviewed", "not_applicable"]},
                "comments": {"type": "string"},
                "finding_details": {"type": "string"},
                "overrides": {"type": "object"},
                "legacy_ids": {"type": "array", "items": {"type": "string"}},
                "group_tree": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["id", "title", "description"],
                    "properties": {
                      "id": {"type": "string"},
                      "title": {"type": "string"},
                      "description": {"type": "string"}
                    }
                  }
                },
                "check_content_ref": {
                  "type": "object",
                  "required": ["href", "name"],
                  "properties": {"href": {"type": "string"}, "name": {"type": "string"}}
                },
                "ccis": {
                  "type": "array",
                  "items": {"type": "string", "pattern": "^CCI-[0-9]{6}$"}
                }
              }
            }
          }
        }
      }
    }
  }
}

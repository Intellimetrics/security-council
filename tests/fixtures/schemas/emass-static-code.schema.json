{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "eMASS static-code-scans POST body (array form)",
  "description": "Conformance schema hand-converted 2026-08-22 from the official eMASS REST OpenAPI spec (github.com/mitre/emass_client docs/eMASSRestOpenApi.yaml, components StaticCodeRequestPostBody + StaticCodeApplicationPost). The array wrapping matches the spec's own request example and MITRE's emasser reference client (lib/emasser/post.rb ScanFindings#add). Fields the spec marks [Required] in prose are required here; cweId additionally enforces the spec's numeric-string example form ('155' - no 'CWE-' prefix).",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["application", "applicationFindings"],
    "properties": {
      "application": {
        "type": "object",
        "additionalProperties": false,
        "required": ["applicationName", "version"],
        "properties": {
          "applicationName": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1}
        }
      },
      "applicationFindings": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "rawSeverity": {
              "type": "string",
              "enum": ["Low", "Medium", "Moderate", "High", "Critical"]
            },
            "codeCheckName": {"type": "string", "minLength": 1},
            "count": {"type": "integer", "minimum": 1},
            "scanDate": {"type": "integer"},
            "cweId": {"type": "string", "pattern": "^[0-9]+$"},
            "clearFindings": {"type": "boolean"}
          },
          "anyOf": [
            {"required": ["codeCheckName", "count", "scanDate", "cweId"]},
            {"required": ["clearFindings"]}
          ]
        }
      }
    }
  }
}

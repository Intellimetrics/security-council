{
  "title": "SecurityCouncilAgentFindings",
  "description": "Portable structured-output subset for claude --json-schema / codex --output-schema / agy --json-schema. Deliberately avoids $schema, pattern, and length/range/count keywords (minItems, maxItems, maxLength, minimum, maximum) that OpenAI/Claude strict structured-output modes reject. Bounds and formats are enforced post-generation by the normalizer + model invariants, not by the schema.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scan", "findings"],
  "properties": {
    "schema_version": {"type": "string", "enum": ["sc-agent-finding/1"]},
    "scan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["angle", "completion", "files_examined", "coverage_notes", "declined_categories"],
      "properties": {
        "angle": {"type": "string"},
        "completion": {"type": "string", "enum": ["complete", "partial", "declined"]},
        "files_examined": {"type": "array", "items": {"type": "string"}},
        "coverage_notes": {"type": "string"},
        "declined_categories": {"type": "array", "items": {"type": "string"}}
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["local_id", "title", "description", "cwe", "category", "severity", "confidence", "locations", "data_flow", "entry_point", "exploit_precondition", "remediation", "evidence"],
        "properties": {
          "local_id": {"type": "string"},
          "title": {"type": "string"},
          "description": {"type": "string"},
          "cwe": {"type": "array", "items": {"type": "string"}},
          "category": {"type": "string", "enum": ["injection", "authz", "authn", "crypto", "secrets", "deserialization", "ssrf", "path_traversal", "xss", "memory", "supply_chain", "config", "llm_safety", "dos", "logging", "other"]},
          "severity": {"type": "string", "enum": ["critical", "high", "medium", "low", "info"]},
          "confidence": {"type": "string", "enum": ["high", "medium", "low"]},
          "locations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "start_line", "end_line", "role", "symbol", "snippet"],
              "properties": {
                "path": {"type": "string"},
                "start_line": {"type": "integer"},
                "end_line": {"type": "integer"},
                "role": {"type": "string", "enum": ["primary", "source", "sink", "sanitizer", "related"]},
                "symbol": {"type": ["string", "null"]},
                "snippet": {"type": "string"}
              }
            }
          },
          "data_flow": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["step", "path", "start_line", "end_line", "role", "note"],
              "properties": {
                "step": {"type": "integer"},
                "path": {"type": "string"},
                "start_line": {"type": "integer"},
                "end_line": {"type": "integer"},
                "role": {"type": "string", "enum": ["source", "propagator", "sanitizer", "sink"]},
                "note": {"type": "string"}
              }
            }
          },
          "entry_point": {"type": ["string", "null"]},
          "exploit_precondition": {"type": "string"},
          "remediation": {"type": "string"},
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "start_line", "end_line", "claim"],
              "properties": {
                "path": {"type": "string"},
                "start_line": {"type": "integer"},
                "end_line": {"type": "integer"},
                "claim": {"type": "string"}
              }
            }
          }
        }
      }
    }
  }
}
